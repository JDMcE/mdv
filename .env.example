# Copy to .env and fill in. .env is ignored by git.

# Require this password to sign in (strongly recommended if reachable from other machines).
MDV_PASSWORD=change-me

# Git remote for your notes. If the vault is empty on first start, it's cloned from here.
# Use a GitHub fine-grained token with Contents: read & write on this repo only.
# MDV_GIT_REMOTE=https://<your-username>:<token>@github.com/<your-username>/<notes>.git
